# ==================== IDE BUILD OUTPUT ====================
.dart_tool/
.packages
pubspec.lock

# ==================== EXCEPTIONS (whitelist specific files) ====================
# These files ARE committed despite matching patterns above
!.gitkeep
!.gitattributes
!README.md
!pubspec.yaml
!analysis_options.yaml
!android/build.gradle.kts
!android/app/build.gradle.kts
!android/gradle/wrapper/gradle-wrapper.properties
!ios/Podfile
!/packages/
